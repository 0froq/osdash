{
  "name": "osdash",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only dashboard of your open-source contributions.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vp run build:local && nuxt dev",
    "build": "vp run build:local && nuxt build && vp run build:relay",
    "build:relay": "rolldown relay/device-relay.ts --platform neutral --external cloudflare:workers --format esm --file .output/server/device-relay.mjs && node tooling/relay-entry.mjs",
    "build:local": "rolldown local/cli.ts --platform node --format esm --file public/downloads/os-bridge.mjs && node tooling/local-checksum.mjs",
    "smoke:relay": "node tooling/relay-smoke.mjs",
    "smoke:service": "node tooling/service-smoke.mjs",
    "deploy": "void deploy --platform cloudflare",
    "preview": "nuxt preview",
    "preview:deploy": "pnpm build && cf previews deploy",
    "lint": "vp lint --config .oxlintrc.json .",
    "lint:fix": "vp lint --config .oxlintrc.json . --fix",
    "fmt": "vp fmt --config .oxfmtrc.json .",
    "fmt:check": "vp fmt --config .oxfmtrc.json . --check",
    "check": "vp run lint && vp run fmt:check && vp run typecheck",
    "typecheck": "nuxt typecheck && vp run typecheck:local && vp run typecheck:relay",
    "typecheck:relay": "tsc --project relay/tsconfig.json",
    "typecheck:local": "tsc --noEmit --target ES2023 --module ESNext --moduleResolution Bundler --allowImportingTsExtensions --strict --skipLibCheck --types node local/cli.ts",
    "postinstall": "nuxt prepare",
    "prepare": "npx simple-git-hooks",
    "test": "vp test --config tooling/vite.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "catalog:prod",
    "@fontsource-variable/geist-mono": "catalog:prod",
    "@fontsource/instrument-serif": "catalog:prod",
    "@froq/ui": "file:vendor/ui",
    "@nuxtjs/i18n": "catalog:prod",
    "h3": "catalog:prod",
    "hast-util-to-text": "catalog:prod",
    "jose": "catalog:prod",
    "nuxt": "catalog:prod",
    "rehype-raw": "catalog:prod",
    "rehype-sanitize": "catalog:prod",
    "rehype-stringify": "catalog:prod",
    "remark-gfm": "catalog:prod",
    "remark-parse": "catalog:prod",
    "remark-rehype": "catalog:prod",
    "unified": "catalog:prod",
    "vue": "catalog:prod",
    "vue-i18n": "catalog:prod",
    "yaml": "catalog:prod"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:dev",
    "@types/hast": "catalog:dev",
    "@types/node": "catalog:dev",
    "cf": "catalog:dev",
    "into-the-void": "catalog:",
    "jiti": "catalog:",
    "lint-staged": "catalog:dev",
    "miniflare": "catalog:dev",
    "rolldown": "catalog:dev",
    "simple-git-hooks": "catalog:dev",
    "typescript": "catalog:dev",
    "vite-plus": "catalog:dev",
    "void": "catalog:dev",
    "vue-tsc": "catalog:dev",
    "wrangler": "catalog:dev"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && npx lint-staged"
  },
  "lint-staged": {
    "*": [
      "vp lint --config .oxlintrc.json --fix --no-error-on-unmatched-pattern",
      "vp fmt --config .oxfmtrc.json --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": "^24.21.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.11.2"
}
